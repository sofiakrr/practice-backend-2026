{
  "info": {
    "name": "Cafe Booking API - Checkpoint 4 Scenario",
    "_postman_id": "cafe-booking-checkpoint4-scenario",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. User Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var d = pm.response.json();",
              "if (d.token) pm.collectionVariables.set('user_token', d.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@cafe.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "2. Resources List (pagination + filter + sort)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "url": {
          "raw": "http://{{base_url}}/api/resources?type=standard&per_page=2&sort_by=price_per_hour&sort_order=asc",
          "host": ["{{base_url}}"],
          "path": ["api", "resources"],
          "query": [
            { "key": "type", "value": "standard" },
            { "key": "per_page", "value": "2" },
            { "key": "sort_by", "value": "price_per_hour" },
            { "key": "sort_order", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "3. Create Booking (happy path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var d = pm.response.json();",
              "if (d.id) pm.collectionVariables.set('created_booking_id', d.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resource_id\": 1,\n  \"date\": \"{{future_date}}\",\n  \"start_time\": \"10:00\",\n  \"end_time\": \"12:00\"\n}"
        },
        "url": {
          "raw": "http://{{base_url}}/api/bookings",
          "host": ["{{base_url}}"],
          "path": ["api", "bookings"]
        }
      }
    },
